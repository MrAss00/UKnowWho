# UKnowWho needs ONE AI provider key for the AI analysis layer.
# Without either key the app still runs in deterministic forensics-only mode.

# Option A — Anthropic (Claude). Supports screenshot/vision scanning.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Option B — DeepSeek (OpenAI-compatible, free trial credit for new accounts).
# Get one at https://platform.deepseek.com/api_keys
# Note: deepseek-chat is text-only — screenshots need an Anthropic key.
# DEEPSEEK_API_KEY=sk-...

# Optional: force a provider when both keys are set ("anthropic" | "deepseek").
# UKNOWWHO_PROVIDER=deepseek

# Optional model overrides:
# UKNOWWHO_ANTHROPIC_MODEL=claude-sonnet-4-6
# UKNOWWHO_DEEPSEEK_MODEL=deepseek-chat
